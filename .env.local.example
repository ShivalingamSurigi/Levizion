# ==============================================================================
# LEVIZION - REAL-TIME VIDEO CALLING CONFIGURATION
# ==============================================================================

# Supabase Configuration
# Obtain from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# LiveKit Real-Time WebRTC Configuration
# Obtain from LiveKit Cloud dashboard (https://cloud.livekit.io) or self-hosted LiveKit Server
# Example Cloud URL: wss://levizion-yourproject.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication & Local Testing Mode
# When true, phone verification accepts any 6-digit OTP (e.g. 123456) or provides demo user switching
# so developers can test 2 simultaneous browser sessions immediately without SMS gateway setup!
NEXT_PUBLIC_DEMO_MODE=true
